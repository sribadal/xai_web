// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// i18n
// =====================================================================

model Locale {
  id   String @id           // "en", "nl", "de"
  name String               // "English", "Nederlands", "Deutsch"

  surveyTranslations       SurveyTranslation[]
  questionTranslations     QuestionTranslation[]
  answerTranslations       AnswerTranslation[]
  glossaryTermTranslations GlossaryTermTranslation[]

  @@map("locales")
}

// =====================================================================
// Explanation dataset (read-only, seeded from Python export)
// =====================================================================

model Patient {
  id         String   @id @default(uuid())
  externalId String   @map("external_id")    // patient_id from the export JSON (0..N)
  modelType  String   @map("model_type")     // "rsf" | "condor"
  features   Json                             // raw feature row
  prediction Json                             // {risk_score, survival_curve?}
  notes      String?                          // admin/supervisor notes (vignette candidacy, quality flags, etc.)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  explanations    Explanation[]
  sessionPatients SessionPatient[]
  responses       Response[]

  @@unique([modelType, externalId])
  @@map("patients")
}

model Explanation {
  id        String @id @default(uuid())
  patientId String @map("patient_id")
  modality  Modality
  method    String                              // "lime" | "dice" | "knn" | "rulefit" | ...
  content   Json
  metadata  Json
  error     String?                             // null = success; non-null = failure, contents of content/metadata may be stubs

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, modality, method])
  @@index([modality, method])
  @@map("explanations")
}

// =====================================================================
// Survey instrument
// =====================================================================

model Survey {
  id          String       @id @default(uuid())
  status      SurveyStatus @default(DRAFT)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  publishedAt DateTime?    @map("published_at")

  // Which dataset to draw vignettes from
  modelType          String @default("rsf") @map("model_type")
  patientsPerSession Int    @default(5)     @map("patients_per_session")

  // Which method represents each modality in this survey.
  // Stored as plain strings so they can be swapped during piloting
  // without a migration.
  attributionMethod    String @map("attribution_method")     // e.g. "lime"
  counterfactualMethod String @map("counterfactual_method")  // e.g. "dice"
  caseBasedMethod      String @map("case_based_method")      // e.g. "knn"
  ruleBasedMethod      String @map("rule_based_method")      // e.g. "rulefit"

  translations SurveyTranslation[]
  questions    Question[]
  sessions     SurveySession[]

  @@map("surveys")
}

model SurveyTranslation {
  id          String  @id @default(uuid())
  surveyId    String  @map("survey_id")
  localeId    String  @map("locale_id")
  title       String
  description String?

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeId], references: [id])

  @@unique([surveyId, localeId])
  @@map("survey_translations")
}

model Question {
  id           String       @id @default(uuid())
  surveyId     String       @map("survey_id")
  type         QuestionType
  isRequired   Boolean      @default(true) @map("is_required")
  displayOrder Int          @map("display_order")
  active       Boolean      @default(true)

  // Optional: scope a question to a specific modality.
  // null = session-level question (e.g. "overall, which did you prefer?")
  modality Modality?

  survey       Survey                @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  translations QuestionTranslation[]
  answers      Answer[]
  responses    Response[]
  tags         QuestionTag[]

  @@index([surveyId])
  @@map("questions")
}

model QuestionTranslation {
  id          String  @id @default(uuid())
  questionId  String  @map("question_id")
  localeId    String  @map("locale_id")
  text        String
  description String?
  helperText  String? @map("helper_text")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  locale   Locale   @relation(fields: [localeId], references: [id])

  @@unique([questionId, localeId])
  @@map("question_translations")
}

model Answer {
  id           String @id @default(uuid())
  questionId   String @map("question_id")
  value        Int
  displayOrder Int    @map("display_order")

  question        Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations    AnswerTranslation[]
  responseAnswers ResponseAnswer[]

  @@unique([questionId, displayOrder])
  @@map("answers")
}

model AnswerTranslation {
  id       String @id @default(uuid())
  answerId String @map("answer_id")
  localeId String @map("locale_id")
  label    String

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeId], references: [id])

  @@unique([answerId, localeId])
  @@map("answer_translations")
}

// =====================================================================
// Glossary
// =====================================================================

model GlossaryTerm {
  id        String   @id @default(uuid())
  term      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations GlossaryTermTranslation[]

  @@map("glossary_terms")
}

model GlossaryTermTranslation {
  id             String @id @default(uuid())
  glossaryTermId String @map("glossary_term_id")
  localeId       String @map("locale_id")
  definition     String

  glossaryTerm GlossaryTerm @relation(fields: [glossaryTermId], references: [id], onDelete: Cascade)
  locale       Locale       @relation(fields: [localeId], references: [id])

  @@unique([glossaryTermId, localeId])
  @@map("glossary_term_translations")
}

// =====================================================================
// Tags
// =====================================================================

model TagGroup {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  tags Tag[]

  @@map("tag_groups")
}

model Tag {
  id      String @id @default(uuid())
  groupId String @map("group_id")
  name    String

  group        TagGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  questionTags QuestionTag[]

  @@unique([groupId, name])
  @@map("tags")
}

model QuestionTag {
  id         String @id @default(uuid())
  questionId String @map("question_id")
  tagId      String @map("tag_id")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([questionId, tagId])
  @@index([tagId])
  @@map("question_tags")
}

// =====================================================================
// Participants & sessions
// =====================================================================

model Participant {
  id         String   @id @default(uuid())
  accessCode String   @unique @map("access_code")
  createdAt  DateTime @default(now()) @map("created_at")

  sessions SurveySession[]

  @@map("participants")
}

model SurveySession {
  id            String        @id @default(uuid())
  surveyId      String        @map("survey_id")
  participantId String        @map("participant_id")
  status        SessionStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now()) @map("started_at")
  completedAt   DateTime?     @map("completed_at")

  // Randomized at session creation so the participant always sees their
  // modality blocks in the same order on refresh.
  modalityOrder Modality[] @map("modality_order")

  survey          Survey           @relation(fields: [surveyId], references: [id])
  participant     Participant      @relation(fields: [participantId], references: [id])
  responses       Response[]
  sessionPatients SessionPatient[]

  @@unique([surveyId, participantId])
  @@map("survey_sessions")
}

// Join: which patients (vignettes) does this session show, and in what order.
// Same N patients are reused across all four modality blocks within the session.
model SessionPatient {
  id           String @id @default(uuid())
  sessionId    String @map("session_id")
  patientId    String @map("patient_id")
  displayOrder Int    @map("display_order")  // 0..patientsPerSession-1

  session SurveySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient       @relation(fields: [patientId], references: [id])

  @@unique([sessionId, patientId])
  @@unique([sessionId, displayOrder])
  @@map("session_patients")
}

// =====================================================================
// Responses
// =====================================================================

model Response {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  questionId   String   @map("question_id")

  // For per-vignette questions: which patient and which modality this
  // answer refers to. Both null for session-level questions.
  patientId    String?   @map("patient_id")
  modality     Modality?

  openText     String?   @map("open_text")
  rankingOrder String[]  @map("ranking_order")   // ordered answer ids (for RANKING questions)
  timeSpentMs  Int?      @map("time_spent_ms")
  answeredAt   DateTime  @default(now()) @map("answered_at")

  session         SurveySession    @relation(fields: [sessionId], references: [id])
  question        Question         @relation(fields: [questionId], references: [id])
  patient         Patient?         @relation(fields: [patientId], references: [id])
  selectedAnswers ResponseAnswer[]

  @@unique([sessionId, questionId, patientId, modality])
  @@index([questionId])
  @@index([patientId])
  @@map("responses")
}

model ResponseAnswer {
  id         String @id @default(uuid())
  responseId String @map("response_id")
  answerId   String @map("answer_id")

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  answer   Answer   @relation(fields: [answerId], references: [id])

  @@unique([responseId, answerId])
  @@index([answerId])
  @@map("response_answers")
}

// =====================================================================
// Enums
// =====================================================================

enum QuestionType {
  LIKERT
  RADIO
  CHECKBOX
  OPEN
  RANKING
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum Modality {
  ATTRIBUTION
  COUNTERFACTUAL
  CASE_BASED
  RULE_BASED
}

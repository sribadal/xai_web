// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Locale {
  id   String @id           // "en", "nl", "de"
  name String               // "English", "Nederlands", "Deutsch"

  surveyTranslations       SurveyTranslation[]
  questionTranslations     QuestionTranslation[]
  answerTranslations       AnswerTranslation[]
  glossaryTermTranslations GlossaryTermTranslation[]

  @@map("locales")
}

model Survey {
  id          String       @id @default(uuid())
  status      SurveyStatus @default(DRAFT)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  publishedAt DateTime?    @map("published_at")

  translations SurveyTranslation[]
  questions    Question[]
  sessions     SurveySession[]

  @@map("surveys")
}

model SurveyTranslation {
  id          String @id @default(uuid())
  surveyId    String @map("survey_id")
  localeId    String @map("locale_id")
  title       String
  description String?

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeId], references: [id])

  @@unique([surveyId, localeId])
  @@map("survey_translations")
}

model Question {
  id           String       @id @default(uuid())
  surveyId     String       @map("survey_id")
  type         QuestionType
  isRequired   Boolean      @default(true) @map("is_required")
  displayOrder Int          @map("display_order")
  active       Boolean      @default(true)

  survey       Survey                @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  translations QuestionTranslation[]
  answers      Answer[]
  responses    Response[]
  tags         QuestionTag[]

  @@map("questions")
}

model QuestionTranslation {
  id          String  @id @default(uuid())
  questionId  String  @map("question_id")
  localeId    String  @map("locale_id")
  text        String
  description String?
  helperText  String? @map("helper_text")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  locale   Locale   @relation(fields: [localeId], references: [id])

  @@unique([questionId, localeId])
  @@map("question_translations")
}

model Answer {
  id           String @id @default(uuid())
  questionId   String @map("question_id")
  value        Int
  displayOrder Int    @map("display_order")

  question        Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations    AnswerTranslation[]
  responseAnswers ResponseAnswer[]

  @@unique([questionId, displayOrder])
  @@map("answers")
}

model AnswerTranslation {
  id       String @id @default(uuid())
  answerId String @map("answer_id")
  localeId String @map("locale_id")
  label    String

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeId], references: [id])

  @@unique([answerId, localeId])
  @@map("answer_translations")
}

model GlossaryTerm {
  id        String   @id @default(uuid())
  term      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations GlossaryTermTranslation[]

  @@map("glossary_terms")
}

model GlossaryTermTranslation {
  id             String @id @default(uuid())
  glossaryTermId String @map("glossary_term_id")
  localeId       String @map("locale_id")
  definition     String

  glossaryTerm GlossaryTerm @relation(fields: [glossaryTermId], references: [id], onDelete: Cascade)
  locale       Locale       @relation(fields: [localeId], references: [id])

  @@unique([glossaryTermId, localeId])
  @@map("glossary_term_translations")
}

model TagGroup {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  tags Tag[]

  @@map("tag_groups")
}

model Tag {
  id      String @id @default(uuid())
  groupId String @map("group_id")
  name    String

  group        TagGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  questionTags QuestionTag[]

  @@unique([groupId, name])
  @@map("tags")
}

model QuestionTag {
  id         String @id @default(uuid())
  questionId String @map("question_id")
  tagId      String @map("tag_id")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([questionId, tagId])
  @@map("question_tags")
}

model Participant {
  id         String   @id @default(uuid())
  accessCode String   @unique @map("access_code")
  createdAt  DateTime @default(now()) @map("created_at")

  sessions SurveySession[]

  @@map("participants")
}

model SurveySession {
  id            String        @id @default(uuid())
  surveyId      String        @map("survey_id")
  participantId String        @map("participant_id")
  status        SessionStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now()) @map("started_at")
  completedAt   DateTime?     @map("completed_at")

  survey      Survey      @relation(fields: [surveyId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])
  responses   Response[]

  @@unique([surveyId, participantId])
  @@map("survey_sessions")
}

model Response {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  questionId   String   @map("question_id")
  openText     String?  @map("open_text")
  rankingOrder String?  @map("ranking_order") // comma-separated answer ids
  timeSpentMs  Int?     @map("time_spent_ms")
  answeredAt   DateTime @default(now()) @map("answered_at")

  session         SurveySession    @relation(fields: [sessionId], references: [id])
  question        Question         @relation(fields: [questionId], references: [id])
  selectedAnswers ResponseAnswer[]

  @@unique([sessionId, questionId])
  @@map("responses")
}

model ResponseAnswer {
  id         String @id @default(uuid())
  responseId String @map("response_id")
  answerId   String @map("answer_id")

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  answer   Answer   @relation(fields: [answerId], references: [id])

  @@unique([responseId, answerId])
  @@map("response_answers")
}

enum QuestionType {
  LIKERT
  RADIO
  CHECKBOX
  OPEN
  RANKING
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}